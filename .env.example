# VYWEED — environment variables
# Copy to .env and fill in your values (.env is git-ignored)

# Backend API (your FastAPI server)
API_BASE_URL=http://localhost:8000

# EAS Build
APP_ENV=development
# EAS_PROJECT_ID is set automatically by `eas build:configure`
EAS_PROJECT_ID=

# Firebase — Firebase Console → Project Settings → Your apps → Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
